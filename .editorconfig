root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2

[*.go]
indent_style = tab
tab_width = 4

[*.odin]
indent_style = tab
tab_width = 4

[Makefile]
indent_style = tab
indent_size = 8

[nginx.conf]
indent_style = tab
tab_width = 4

[*.json]
indent_style = space
indent_size = 2

[*.cpp]
indent_size = 4

[*.c3]
indent_size = 4

[*.rs]
indent_size = 4
